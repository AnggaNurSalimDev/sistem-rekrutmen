# Alamat backend. Salin menjadi .env.local jika berbeda dari bawaan.
VITE_API_URL=http://localhost:3000

# Profil perusahaan yang dipakai (nama file di src/merek/profil, tanpa .json).
VITE_PROFIL=rekrut

# true hanya untuk demo portofolio: menampilkan pengalih profil di bawah halaman
# dan mengizinkan ?profil=<id> di alamat. Di situs klien biarkan false.
VITE_MODE_DEMO=false

# true untuk situs demo yang dibagikan tanpa backend (lihat src/simulasi/README.md):
# seluruh alur (lamaran, tes, dashboard HR) berjalan di browser pengunjung sendiri,
# datanya hanya tersimpan di localStorage masing-masing, tidak pernah dikirim ke
# mana pun. VITE_API_URL tidak dipakai sama sekali jika ini true. Di situs klien
# sungguhan (yang butuh backend asli) biarkan false.
VITE_SIMULASI=false
