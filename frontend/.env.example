# Alamat backend. Salin menjadi .env.local jika berbeda dari bawaan.
VITE_API_URL=http://localhost:3000

# Profil perusahaan yang dipakai (nama file di src/merek/profil, tanpa .json).
VITE_PROFIL=rekrut

# true hanya untuk demo portofolio: menampilkan pengalih profil di bawah halaman
# dan mengizinkan ?profil=<id> di alamat. Di situs klien biarkan false.
VITE_MODE_DEMO=false
