# Salin menjadi .env lalu isi. Jangan commit file .env.

NODE_ENV=development
PORT=3000

# postgres://user:password@host:port/database
DATABASE_URL=postgres://rekrutmen:rekrutmen@localhost:5432/rekrutmen

# Minimal 32 karakter, dan keduanya harus berbeda.
# Buat dengan: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
STORAGE_SIGNING_SECRET=

JWT_EXPIRES_IN=8h

# Penyimpanan berkas CV. Saat ini hanya driver "local" (folder di disk).
STORAGE_DRIVER=local
STORAGE_DIR=./storage
SIGNED_URL_TTL_SECONDS=300
PUBLIC_BASE_URL=http://localhost:3000

# Alamat frontend (Vite default 5173). Pisahkan dengan koma untuk lebih dari satu.
CORS_ORIGIN=http://localhost:5173

# true untuk demo: siapa pun bisa mendaftar sebagai rekruter.
# Di produksi sebaiknya false, dan akun rekruter dibuat lewat undangan.
ALLOW_REKRUTER_SIGNUP=true
